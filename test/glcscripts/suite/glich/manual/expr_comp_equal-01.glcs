// expr_comp_equal-01.glcs  Verify comparison equal and non-equal examples.
// Example in dev\man\script\expr.htm.

write nl;
write 10.0 = 10 nl;
write 10 <> 10.0 nl;
write 10.5 = 10 nl;
write "cat" = "cat" nl;
write 1..3 = 3..1 nl;
write 1..3 | 10..12 = 1..3 | 12..10 nl;
write {: "one", 2} = {: "one", 1 + 1} nl;
write null = null nl;
write null = empty nl;

// Special values
write nl;
write nan = nan nl;
write nan <> nan nl;
write ? = ? nl;
write ? <> ? nl;
write nan = ? nl;
write ? <> nan nl;

/*[OUTPUT]

true
false
false
true
true
true
true
true
false

false
true
true
false
false
true

[OUTPUT]*/

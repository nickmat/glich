// expr_comp_mag-01.glcs  Verify comparison magnitude examples.
// Example in dev\man\script\expr.htm.

write nl;
write 5 < 10 nl;
write 10 <= 10.0 nl;
write 10 > infinity nl;
write 5 < ? nl;
write ? < nan nl;
write (1..3) < 10 nl;
write "apple" < "banana" nl;
write "z" >= "a" nl;


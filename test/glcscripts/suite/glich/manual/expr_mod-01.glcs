// expr_mod-01.glcs  Verify Arithmetic modulus examples.
// Example in dev\man\script\expr.htm.


// Floats
write nl;
write 50 % 10.0 nl;
write 50 % 11 nl;
write -7 % 2 nl;
write infinity % 999 nl;
write 10 % infinity nl;
write 19 % 0 nl;



// expr_union-01.glcs  Verify Union Operator examples.
// Example in dev\man\script\expr.htm.


// Union
write nl;
write 0 | 5..10 nl;
write 5..10 | 8..25 nl;
write empty | 5..10 nl;
write -infinity..123 | 5..10 nl;
write 5..10 | 20..25 | 11..19 nl;
write -infinity..10 | 20..25 | 30..35 nl;


/*[OUTPUT]

0 | 5..10
5..25
5..10
-infinity..123
5..25
-infinity..10 | 20..25 | 30..35

[OUTPUT]*/

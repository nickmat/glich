// expr_divmod-01.glcs  Verify Arithmetic division and modulus examples.
// Example in dev\man\script\expr.htm.


// Floats
write nl;
write 80 /% 13 nl;
write -80 /% 13 nl;
write 80 /% -13 nl;
write -80 /% -13 nl;
write infinity /% 99 nl;
write ? /% 99 nl;
write 17 /% infinity nl;



// range002.glcs - @field( value, default ) // convert value to range using default.

let mf = @number( max_field );
let bn = mf + 1n;


// Use default range values tests.
write nl;
write @range( null, 1..3 ) nl;
write @range( true, 1..3 ) nl;
write @range( 1.2, 1..3 ) nl;
write @range( {: 10, 11}, 1..3 ) nl;
write @range( "This is a test", 1..3 ) nl;
write @range( 100 | 199..200, 1..3 ) nl;
write @range( bn, 1..3 ) nl;
write @range( -bn, 1..3 ) nl;
write @range( ?, 1..3 ) nl;
write @range( @error( "Test" ), 1..3 ) nl;

/*[OUTPUT]

1..3
1..3
1..3
1..3
1..3
1..3
1..3
1..3
1..3
1..3

[OUTPUT]*/

// field002.glcs - @field( value, default ) // convert value to field.

let bn = @number( max_field ) + 1n;

write nl;
write @field( null, 0 ) nl;
write @field( true, 0 ) nl;
write @field( {: 10, 11}, 0 ) nl;
write @field( 123..321, 0 ) nl;
write @field( @rlist( 123..321 ), 0 ) nl;
write @field( "123 | 123..321", 0 ) nl;
write @field( "This is a test", 0 ) nl;
write @field( 100 | 199..200, 0 ) nl;
write @field( max_field + 1, 0 ) nl;
write @field( -( max_field + 1 ), 0 ) nl;
write @field( bn, 0 ) nl;
write @field( -bn, 0 ) nl;
write @field( @error( "Test" ), 0 ) nl;


/*[OUTPUT]

0
0
0

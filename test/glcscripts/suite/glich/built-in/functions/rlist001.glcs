// rlist001.glcs - @rlist( value ) // convert value to rlist.

let big = @number( max_field ) + 1;

// Valid rlist values tests.
write nl;
write @rlist( max_field | 1 ), @type(@rlist( max_field | 1 )) nl;
write @rlist( -max_field| 1 ), @type(@rlist( -max_field| 1  )) nl;
write @rlist( max_field  ), @type(@rlist( max_field )) nl;
write @rlist( -max_field ), @type(@rlist( -max_field )) nl;
write @rlist( infinity | 1 ), @type(@rlist( infinity | 1 )) nl;
write @rlist( 123n ), @type(@rlist( 123n )) nl;
write @rlist( 123..321 ), @type(@rlist( 123..321 )) nl;
write @rlist( 100 | 123..321 ), @type(@rlist( 100 | 123..321 )) nl;
write @rlist( "123..321" ), @type(@rlist( "123..321" )) nl;
write @rlist( "100 | 123..321" ), @type(@rlist( "100 | 123..321" )) nl;

// Invalid rlist values tests.
write nl;
write @rlist( null ) nl;
write @rlist( true ) nl;
write @rlist( 1.2 ) nl;
write @rlist( {: 10, 11} ) nl;
write @rlist( "This is a test" ) nl;
write @rlist( big ) nl;
write @rlist( -big ) nl;
write @rlist( ? ) nl;


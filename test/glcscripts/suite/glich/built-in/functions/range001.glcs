// range001.glcs - @range( value ) // convert value to range.

let big = @number( max_field ) + 1;

// Valid range values tests.
write nl;
write @range( max_field ), @type(@range( max_field )) nl;
write @range( -max_field ), @type(@range( -max_field )) nl;
write @range( infinity ), @type(@range( infinity )) nl;
write @range( 123n ), @type(@range( 123n )) nl;
write @range( 123..321 ), @type(@range( 123..321 )) nl;
write @range( @rlist( 123..321 ) ), @type(@range(@rlist( 123..321 ))) nl;
write @range( "123..321" ), @type(@range( "123..321" )) nl;
write @range( "123 | 123..321" ), @type(@range( "123 | 123..321" )) nl;

// Invalid range values tests.
write nl;
write @range( null ) nl;
write @range( true ) nl;
write @range( 1.2 ) nl;
write @range( {: 10, 11} ) nl;
write @range( "This is a test" ) nl;
write @range( 100 | 199..200 ) nl;
write @range( big ) nl;
write @range( -big ) nl;
write @range( ? ) nl;

/*[OUTPUT]

2147483644, range
-2147483644, range
+infinity, range
123, range
123..321, range
123..321, range
123..321, range
123..321, range


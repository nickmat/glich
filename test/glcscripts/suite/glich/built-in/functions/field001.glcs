// field001.glcs - @field( value ) // convert value to field.

let mf = @number( max_field );
let bn = mf + 1n;

// Valid field values tests.
write nl;
write @field( mf ), @type(@field( mf )) nl;
write @field( -mf ), @type(@field( -mf )) nl;
write @field( infinity ), @type(@field( infinity )) nl;
write @field( 123n ), @type(@field( 123n )) nl;
write @field( 1.7 ), @type(@field( 1.7 )) nl;
write @field( "-10" ), @type(@field( "-10" )) nl;
write @field( "11+1..13-1" ), @type(@field( "11+1..13-1" )) nl;
write @field( "?" ), @type(@field( "?" )) nl;

// Invalid field values tests.
write nl;
write @field( null ) nl;
write @field( true ) nl;
write @field( {: 10, 11} ) nl;
write @field( 123..321 ), @type(@field( 123..321 )) nl;
write @field( @rlist( 123..321 ) ), @type(@field(@rlist( 123..321 ))) nl;
write @field( "123 | 123..321" ), @type(@field( "123 | 123..321" )) nl;
write @field( "This is a test" ) nl;
write @field( 100 | 199..200 ) nl;
write @field( max_field + 1 ) nl;
write @field( -( max_field + 1 ) ) nl;
write @field( bn ) nl;
write @field( -bn ) nl;
write @field( @error( "Test" ) ) nl;


/*[OUTPUT]

2147483644, field
-2147483644, field
+infinity, field
123, field
2, field
-10, field
12, field
?, field


// plus019.glcs Test file to test addition overflow with rlists.


let bf = max_field;
let bn = @number(bf);

write nl;
write bf, bn nl;
write bf + (-3..-1 | 1..3) nl;
write (-3..-1 | 1..3) + bf nl;
write bn + (-3..-1 | 1..3) nl;
write (-3..-1 | 1..3) + bn nl;

/*[OUTPUT]

2147483644, 2147483644
Error file:plus019 (9): Field overflow in rlist.
Error file:plus019 (10): Field overflow in rlist.
Error file:plus019 (11): Field overflow in rlist.
Error file:plus019 (12): Field overflow in rlist.

[OUTPUT]*/

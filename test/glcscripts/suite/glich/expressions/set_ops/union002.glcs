// union002.glcs Test invalid union operations.

write nl;
write max_field | 1..3 nl;
write max_field + 1 | 1..3 nl;
write ? | 1..3 nl;
write 1..3 | ? nl;
write ? | ? nl;

/*[OUTPUT]

1..3 | 2147483644
Error file:union002 (5): Cannot convert left hand to RList.
Error file:union002 (6): Cannot convert left hand to RList.
Error file:union002 (7): Cannot convert right hand to RList.
Error file:union002 (8): Cannot convert left hand to RList.

[OUTPUT]*/

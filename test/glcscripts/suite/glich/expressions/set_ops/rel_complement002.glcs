// rel_complement002.glcs Test invalid relative complement operations.

write nl;
write max_field \\ 1..3 nl;
write max_field + 1 \\ 1..3 nl;
write ? \\ 1..3 nl;
write 1..3 \\ ? nl;
write ? \\ ? nl;



// sym_difference002.glcs Test invalid symmetric difference operations.

let big = @number( max_field ) + 1;

write nl;
write max_field ^^ 1..3 nl;
write big ^^ 1..3 nl;
write ? ^^ 1..3 nl;
write 1..3 ^^ ? nl;
write ? ^^ ? nl;



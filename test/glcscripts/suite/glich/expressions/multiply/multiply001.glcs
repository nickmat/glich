// multiply001.glcs Test file for multiplication of fields


write nl;
write 15 * 3, -15 * 3, 15 * -3, -15 * -3, 0 * 3 nl;

write -infinity * 3, infinity * 3, 15 * -infinity, 15 * infinity nl;
write -infinity * -3, infinity * -3, -15 * -infinity, -15 * infinity nl;

write -infinity * -infinity, infinity * infinity nl;



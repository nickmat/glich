// minus013.glcs Test file to test subtraction of special values.

let a = 5f - -inf;

let b = inf - 10f;

let c = nan - 100f;

let d = -inf - +infinity;

let e = -inf - ?;

let f = -inf - -infinity;

let g = inf - inf;


write a, b, c, d, e, f, g;

/*[OUTPUT]
inf, inf, nan, -inf, nan, nan, nan
[OUTPUT]*/

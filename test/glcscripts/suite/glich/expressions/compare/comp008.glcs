// comp008.glcs Test file for equality operator with ranges and rlists.

write nl;
write {: 1, 2} = {: 1, 2} nl;
write {: 1, 2} = {: 1, 3} nl;
write null = null nl;
write 1f = null nl;
write 1..2 | 5 = 5 | 2..1 nl;
write 1..2 | 6 = 5 | 2..1 nl;
write 1..1 = 1..1 | 1 nl;
write 5 = 5..5 nl;

/*[OUTPUT]

true
false
true
false
true
false
true
true

[OUTPUT]*/

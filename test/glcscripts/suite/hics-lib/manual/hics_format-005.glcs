write nl;
write @date.g:u( "9month1948year19day" ) nl;
write @date.g:u( "2023y 4d 13m" ) nl;
write @scheme.g:u( "9 month" ) nl;
write @scheme.g:u( "2023y 9m 21d" ) nl;
write @text.g:u( 2460048 ) nl;


// hics/schemes/ls_c-001.glcs - Test library scheme Chinese "c".
// Check the scheme object and its formats.

let detail = @sch:object.c;

write nl;
write detail@obj:list nl;

write nl;
write "Default input format:-" nl;
write @fmt:object.("c:" + detail[.default:in])@obj:list nl;


write nl;
do d in detail[.formats] {
    let fmt = "c:" + d;
    write @fmt:object.(fmt) nl;
};



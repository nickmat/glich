// hics/schemes/ls_cg-001.glcs - Test library scheme Chinese "cg".
// Check the scheme object and its formats.

let detail = @sch:object.cg;

write nl;
write detail@obj:list nl;

write nl;
write "Default input format:-" nl;
write @fmt:object.("cg:" + detail[.default:in])@obj:list nl;


write nl;
do d in detail[.formats] {
    let fmt = "c:" + d;
    write @fmt:object.(fmt) nl;
};



// ft_c-001.glcs  Create c scheme format table.
/*[SKIP]*/
let sch = "c";

let d1 = 2460866;
let d2 = 2460896;
let d3 = 2460925;

let so = @sch:object.(sch);
let sfl = so[.formats];
let size = @size( sfl );
let index = 0;

write nl;
write "<table class='basic data'>" nl;
write "<tr><th colspan='4'>Formats - Grammar " + so[.grammar] + "</th></tr>" nl;
write "<tr><th>Code</th><th>Rule</th><th>Pseudo / Example</th><th>Note</th></tr>" nl;

do {
    let fmt = sfl[(index)];
    let sig = sch + ":" + fmt;
    let fo = @fmt:object.(sig);
    let note = @if(fo[.visible], "", "H");
    if so[.default:in] = fmt or so[.default:out] = fmt {
        if @size( note ) > 0 {
            note += ", ";
        };
        note += "D";
    };
    if fo[.shorthand] {
        if @size( note ) > 0 {
            note += ", ";
        };
        note += "S";
    };
    
    let p = fo[.pseudo:in];
    if @size(p) > 0 {
        p = "<b>Input:</b> " + p + "<br />";
    };
    p = "<td>" + p + "<b>Output:</b> " + fo[.pseudo:out] + "</td>";

    let row = "<tr><td rowspan='2'><b>" + fo[.code] + "</b></td>"
      + "<td rowspan='2'>" +fo[.rules] + "</td>"
      + p
      + "<td rowspan='2'>" + note + "</td>"
      + "</tr>";

    write row nl;
  
    let row2 = "<tr><td class='example'>"
      + @text.(sig)(d1) + "<br />"
      + @text.(sig)(d2) + "<br />"
      + @text.(sig)(d3)
      + "</td></tr>";
    write row2 nl;


    index += 1;
    until index = size;
};

write "<tr><td colspan='6'>Notes: D = Default, H = Hidden, S = Range shortcut supported." nl;
write "Example based on jdn# " + d1, d2 + " and " + d3 + "</td></tr>" nl;
write "</table>" nl;


/*[OUTPUT]

<table class='basic data'>
<tr><th colspan='4'>Formats - Grammar ccsy</th></tr>
<tr><th>Code</th><th>Rule</th><th>Pseudo / Example</th><th>Note</th></tr>
<tr><td rowspan='2'><b>cymld</b></td><td rowspan='2'>text</td><td><b>Input:</b> cycle segyear month lmonth day<br /><b>Output:</b> cc sy mm lm dd</td><td rowspan='2'>D, S</td></tr>
<tr><td class='example'>78 42 6 f 15<br />78 42 6 s 15<br />78 42 7 f 15</td></tr>
<tr><td rowspan='2'><b>cylmd</b></td><td rowspan='2'>text</td><td><b>Input:</b> cycle segyear clmonth month day<br /><b>Output:</b> cc sy clmonth mm dd</td><td rowspan='2'></td></tr>
<tr><td class='example'>78 42 Regular 6 15<br />78 42 Leap 6 15<br />78 42 7 15</td></tr>
<tr><td rowspan='2'><b>cylmd_s</b></td><td rowspan='2'>text</td><td><b>Input:</b> cycle stem branch clmonth month day<br /><b>Output:</b> cc ss-bb, clmonth mm dd</td><td rowspan='2'></td></tr>
<tr><td class='example'>78 Yǐ-sì, Regular 6 15<br />78 Yǐ-sì, Leap 6 15<br />78 Yǐ-sì 7 15</td></tr>
<tr><td rowspan='2'><b>cylmd_f</b></td><td rowspan='2'>text</td><td><b>Input:</b> cycle stem branch segyear clmonth month day<br /><b>Output:</b> Cycle: cc Year: ss-bb (sy) clmonth Month: mm Day: dd</td><td rowspan='2'></td></tr>
<tr><td class='example'>Cycle: 78 Year: Yǐ-sì (42) Regular Month: 6 Day: 15<br />Cycle: 78 Year: Yǐ-sì (42) Leap Month: 6 Day: 15<br />Cycle: 78 Year: Yǐ-sì (42) Month: 7 Day: 15</td></tr>
<tr><td rowspan='2'><b>cy_animal</b></td><td rowspan='2'>text</td><td><b>Input:</b> cycle branch segyear lmonth month day<br /><b>Output:</b> (Cycle cc) Year of the bb sy lm mm Day dd</td><td rowspan='2'>S</td></tr>
<tr><td class='example'>(Cycle 78) Year of the Snake 42 Regular Month 6 Day 15<br />(Cycle 78) Year of the Snake 42 Leap Month 6 Day 15<br />(Cycle 78) Year of the Snake 42 Regular Month 7 Day 15</td></tr>
<tr><td rowspan='2'><b>ymld</b></td><td rowspan='2'>text</td><td><b>Input:</b> year month lmonth day<br /><b>Output:</b> yyyy mm lm dd</td><td rowspan='2'>S</td></tr>
<tr><td class='example'>4662 6 f 15<br />4662 6 s 15<br />4662 7 f 15</td></tr>
<tr><td rowspan='2'><b>ylmd</b></td><td rowspan='2'>text</td><td><b>Input:</b> year clmonth month day<br /><b>Output:</b> yyyy clmonth mm dd</td><td rowspan='2'></td></tr>
<tr><td class='example'>4662 First 6 15<br />4662 Second 6 15<br />4662 7 15</td></tr>
<tr><td rowspan='2'><b>animal</b></td><td rowspan='2'>text</td><td><b>Input:</b> year branch lmonth month day<br /><b>Output:</b> yyyy Year of the bb, lm mm Day dd</td><td rowspan='2'>S</td></tr>
<tr><td class='example'>4662 Year of the Snake, Regular Month 6 Day 15<br />4662 Year of the Snake, Leap Month 6 Day 15<br />4662 Year of the Snake, Regular Month 7 Day 15</td></tr>
<tr><td rowspan='2'><b>elem_anim</b></td><td rowspan='2'>text</td><td><b>Input:</b> year polarity element branch lmonth month day<br /><b>Output:</b> yyyy The polarity-e-bb Year lm mm Day dd</td><td rowspan='2'>S</td></tr>
<tr><td class='example'>4662 The Yin-Wood-Snake Year Regular Month 6 Day 15<br />4662 The Yin-Wood-Snake Year Leap Month 6 Day 15<br />4662 The Yin-Wood-Snake Year Regular Month 7 Day 15</td></tr>
<tr><td rowspan='2'><b>a</b></td><td rowspan='2'>text</td><td><b>Input:</b> year month lmonth day cycle segyear stem branch element polarity clmonth<br /><b>Output:</b> yyyy mm lm dd cc sy ss bb e polarity clmonth</td><td rowspan='2'>H</td></tr>
<tr><td class='example'>4662 6 1 15 78 42 2 6 1 2<br />4662 6 2 15 78 42 2 6 1 2<br />4662 7 1 15 78 42 2 6 1 2</td></tr>
<tr><td rowspan='2'><b>r</b></td><td rowspan='2'>text</td><td><b>Input:</b> year month lmonth day<br /><b>Output:</b> yyyy mm lm dd</td><td rowspan='2'>H, S</td></tr>
<tr><td class='example'>4662 6 1 15<br />4662 6 2 15<br />4662 7 1 15</td></tr>
<tr><td rowspan='2'><b>u</b></td><td rowspan='2'>unit</td><td><b>Input:</b> 9y 9m 9lm 9d 9c 9sy 9s 9b 9e 9p 9clmonth<br /><b>Output:</b> 9y 9m 9lm 9d 9c 9sy 9s 9b 9e 9p 9clmonth</td><td rowspan='2'>H</td></tr>
<tr><td class='example'>4662y 6m 1lm 15d 78c 42sy 2s 6b 1e 2p<br />4662y 6m 2lm 15d 78c 42sy 2s 6b 1e 2p<br />4662y 7m 1lm 15d 78c 42sy 2s 6b 1e 2p</td></tr>
<tr><td colspan='6'>Notes: D = Default, H = Hidden, S = Range shortcut supported.
Example based on jdn# 2460866, 2460896 and 2460925</td></tr>
</table>

[OUTPUT]*/

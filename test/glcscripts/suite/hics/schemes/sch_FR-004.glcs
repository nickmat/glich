//write "@scheme.FR( ""4 Fruc 234"" ) = " + @scheme.FR:cdmy( "4 Fruc 234" ) nl;
//write "@scheme.FR( ""2 Comp 234"" ) = " + @scheme.FR:cdmy( "2 Comp 234" ) nl;


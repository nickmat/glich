write nl;
write @sch:object.FR[.formats] nl;
write "@scheme.FR( 2461274 ) = " + @scheme.FR( 2461274 ) nl;
write "@scheme.FR( 2461302 ) = " + @scheme.FR( 2461302 ) nl;


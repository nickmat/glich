// sch_CG-001.glcs  Test Chinese scheme with Gregorian year count.

scheme G {
    name "Gregorian";
    base gregorian;
};

scheme C {
    name "Chinese";
    base chinese;
};

scheme CG {
    name "Chinese with Gregorian Year";
    base chinese year:2637;
};

let d = 2461149;
write nl;
write @scheme.G(d) nl;
write @scheme.C(d) nl;
write @scheme.CG(d) nl;

/*[OUTPUT]

{s:G 2026, 4, 18}
{s:C 4663, 3, 1, 2}
{s:CG 2026, 3, 1, 2}

[OUTPUT]*/

// hics/schemes/cg-03.glcs - Test Proposed Chinese Calendar with Gregorian Year
// scheme shorthand ranges and additional fields for Chinese year animals, elements, and polarity. 

lexicon FS {
    name "First and Second";
    fieldname lmonth;
    lang en;
    pseudo     FirstSecond,     FS;
    tokens {
        1,  "First", "F";
        2,  "Second", "S";
    };
};

lexicon ANIMAL {
    name "Chinese Year Animals";
    fieldname branch;
    lang en;
    pseudo  Animal;
    tokens {
        1,  "Rat";
        2,  "Ox";
        3,  "Tiger";
        4,  "Rabbit";
        5,  "Dragon";
        6,  "Snake";
        7,  "Horse";
        8,  "Goat";
        9,  "Monkey";
        10, "Rooster";
        11, "Dog";
        12, "Pig";
    };
};

lexicon ELEMENT {
    name "Chinese Year Elements";
    fieldname element;
    lang en;
    pseudo  Element;
    tokens {
        1,  "Wood";
        2,  "Fire";
        3,  "Earth";
        4,  "Metal";
        5,  "Water";
    };
};

lexicon YINYANG {
    name "Chinese Year Polarity";
    fieldname polarity;
    lang en;
    pseudo  Pol;
    tokens {
        1,  "Yang";
        2,  "Yin";
    };
};

lexicon LMON {
    name "Leap month";
    fieldname lmonth;
    lang en;
    pseudo     LeapMon,     LM;
    tokens {
        1,  "Regular Month", "Regular";
        2,  "Leap Month", "Leap";
    };
};

grammar C {
    fields year month lmonth day cycle segyear stem branch element polarity;
    rank year month lmonth day;

    alias pseudo { dd day; mm month; lm lmonth; yyyy year; cc cycle; sy segyear; ss stem; bb branch; e element; y yinyang; };
    alias unit { d day; m month; lm lmonth; y year; c cycle; sy segyear; s stem; b branch; e element; p polarity; };

    format ymld "{year}| {month}| {lmonth:FS:a:l}| {day}";
    format animal "{year} Year of the {:branch:ANIMAL}|, {lmonth:LMON}| {month}| Day {day}";
    format elem_anim {
       inout "{year} The {:polarity:YINYANG}-{:element:ELEMENT}-{:branch:ANIMAL} Year| {lmonth:LMON}| {month}| Day {day}";
       separators "-,:";
    };
    preferred ymld;
};

scheme CG {
  name "Chinese with Gregorian Year";
  base chinese "year:+2637" additional;
  grammar C;
};

write nl;
write "Shorthand for ymld: " + @fmt:object.CG:ymld[.shorthand] nl;
write @date.CG( "2025 6 f 15" ), @text.CG( 2460866 ) nl;
write @date.CG( "2025 6 f" ), @text.CG( 2460852..2460881 ) nl;
write @date.CG( "2025 6 s" ), @text.CG( 2460882..2460910 ) nl;
write @date.CG( "2025 7 f" ), @text.CG( 2460911..2460940 ) nl;
write @date.CG( "2025 6" ), @text.CG( 2460852..2460910 ) nl;
write @date.CG( "2025 7" ), @text.CG( 2460911..2460940 ) nl;
write @date.CG( "2025" ), @text.CG( 2460705..2461088 ) nl;
write "Shorthand for animal: " + @fmt:object.CG:animal[.shorthand] nl;
write @date.CG:animal( @text.CG:animal( 2460866 ) ), @text.CG:animal( 2460866 ) nl;
write @date.CG:animal( "2025 Year of the Snake" ), @text.CG:animal( 2460705..2461088 ) nl;
write "Shorthand for elem_anim: " + @fmt:object.CG:elem_anim[.shorthand] nl;
write @date.CG:elem_anim( @text.CG:elem_anim( 2460866 ) ), @text.CG:elem_anim( 2460866 ) nl;
write @date.CG:elem_anim( "2025 The Yin-Wood-Snake Year" ), @text.CG:elem_anim( 2460705..2461088 ) nl;


/*[OUTPUT]

Shorthand for ymld: true
2460866, 2025 6 f 15
2460852..2460881, 2025 6 f
2460882..2460910, 2025 6 s
2460911..2460940, 2025 7
2460852..2460910, 2025 6
2460911..2460940, 2025 7
2460705..2461088, 2025
Shorthand for animal: true
2460866, 2025 Year of the Snake, Regular Month 6 Day 15
2460705..2461088, 2025 Year of the Snake
Shorthand for elem_anim: true
2460866, 2025 The Yin-Wood-Snake Year Regular Month 6 Day 15
2460705..2461088, 2025 The Yin-Wood-Snake Year

[OUTPUT]*/

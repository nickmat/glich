lexicon cstem {
    name "Chinese Year Stem";
    fieldname stem;
    lang en;
    pseudo   Stem,   Stm;
    tokens {
        1,  "Jiǎ",  "Jia";
        2,  "Yǐ",   "Yi";
        3,  "Bǐng", "Bing";
        4,  "Dīng", "Ding";
        5,  "Wù",   "Wu";
        6,  "Jǐ",   "Ji";
        7,  "Gēng", "Geng";
        8,  "Xīn",  "Xin";
        9,  "Rén",  "Ren";
        10, "Guì",  "Gui";
    };
};

lexicon cbrch {
    name "Chinese Year Branch";
    fieldname branch;
    lang en;
    pseudo  branch,  brch;
    tokens {
        1,  "Zǐ",   "Zi";
        2,  "Chǒu", "Chou";
        3,  "Yín",  "Yin";
        4,  "Mǎo",  "Mao";
        5,  "Chén", "Chen";
        6,  "Sì",   "Si";
        7,  "Wǔ",   "Wu";
        8,  "Wèi",  "Wei";
        9,  "Shēn", "Shen";
        10, "Yǒu",  "You";
        11, "Xū",   "Xu";
        12, "Hài",  "Hai";
    };
};

lexicon animal {
    name "Chinese Year Animal";
    fieldname branch;
    lang en;
    pseudo  Animal;
    tokens {
        1,  "Rat";
        2,  "Ox";
        3,  "Tiger";
        4,  "Rabbit";
        5,  "Dragon";
        6,  "Snake";
        7,  "Horse";
        8,  "Goat";
        9,  "Monkey";
        10, "Rooster";
        11, "Dog";
        12, "Pig";
    };
};

lexicon element {
    name "Chinese Year Element";
    fieldname element;
    lang en;
    pseudo  Element;
    tokens {
        1,  "Wood";
        2,  "Fire";
        3,  "Earth";
        4,  "Metal";
        5,  "Water";
    };
};

lexicon yinyang {
    name "Chinese Year Polarity";
    fieldname polarity;
    lang en;
    pseudo  Pol;
    tokens {
        1,  "Yang";
        2,  "Yin";
    };
};

lexicon fs {
    name "First and Second";
    fieldname lmonth;
    lang en;
    pseudo  FirstSecond, FS;
    tokens {
        1,  "First", "F";
        2,  "Second", "S";
    };
};

lexicon fs2 {
    name "First and Second for clmonth";
    inherit fs;
    fieldname clmonth;
};

lexicon lmon {
    name "Regular or Leap month";
    fieldname lmonth;
    lang en;
    pseudo     LeapMon,     LM;
    tokens {
        1,  "Regular Month", "Regular";
        2,  "Leap Month", "Leap";
    };
};

lexicon lmon2 {
    name "Regular or Leap month for clmonth";
    inherit lmon;
    fieldname clmonth;
}; 

grammar c {
    name "Chinese year count formats";
    fields year month lmonth day cycle segyear stem branch element polarity;
    rank year month lmonth day;
    calculated clmonth;

    alias pseudo { dd day; mm month; lm lmonth; yyyy year; cc cycle; sy segyear; ss stem; bb branch; e element; y yinyang; pol polarity; cl clmonth; };
    alias unit { d day; m month; lm lmonth; y year; c cycle; sy segyear; s stem; b branch; e element; p polarity; cl clmonth; };

    function calculate_clmonth {
        clmonth = @if(lmonth=1, @if(@leapmonth.(scode)( year, month),1,null), 2);
        result = this;
    };

    function fixed_from_clmonth {
        lmonth = @if(clmonth<>2, 1, 2);
        result = this;
    };

    format ymld "{year}| {month}| {lmonth:fs:a:l}| {day}";
    format ylmd {
        inout "{year}| {clmonth:fs2}| {month}| {day}";
        rank year month day;
        functions {
            calculate calculate_clmonth;
            fixed fixed_from_clmonth;
        };
    };
    format animal "{year} Year of the {:branch:animal}|, {lmonth:lmon}| {month}| Day {day}";
    format elem_anim {
        inout "{year} The {:polarity:yinyang}-{:element:element}-{:branch:animal} Year| {lmonth:lmon}| {month}| Day {day}";
        separators ",-";
    };
    preferred ymld;
};

grammar ccsy {
    name "Chinese cycle and segyear formats";
    inherit c;
    // Note, format used in "Calendrical Calculations"
    format cymld {
        inout "{cycle}| {segyear}| {month}| {lmonth:fs:a:l}| {day}";
        rank cycle segyear month lmonth day;
    };
    format cylmd {
        inout "{cycle}| {segyear}| {clmonth:lmon2:a}| {month}| {day}";
        rank cycle segyear month day;
         functions {
            calculate calculate_clmonth;
            fixed fixed_from_clmonth;
        };
    };
    format cylmd_s {
        inout "{cycle}| {stem:cstem}|-{branch:cbrch::l}|, {clmonth:lmon2:a}| {month}| {day}";
        rank cycle month day;
        separators ",-";
        functions {
            calculate calculate_clmonth;
            fixed fixed_from_clmonth;
        };
    };
    format cylmd_f {
        inout "Cycle: {cycle}| Year: {:stem:cstem}-{:branch:cbrch::l} ({segyear})| {clmonth:lmon2:a}| Month: {month}| Day: {day}";
        rank cycle segyear month day;
        separators ",-";
        functions {
            calculate calculate_clmonth;
            fixed fixed_from_clmonth;
        };
    };
    format cy_animal {
        inout "(Cycle {cycle})| Year of the {:branch:animal} {segyear}| {lmonth:lmon}| {month}| Day {day}";
        rank cycle segyear month lmonth day;
    };
    preferred cymld;
};

scheme c {
  name "Chinese";
  base chinese additional;
  grammar ccsy;
};

scheme cg {
  name "Chinese with Gregorian Year";
  base chinese "year:+2637" additional;
  grammar c;
};

